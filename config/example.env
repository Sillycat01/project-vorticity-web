# Project Vorticity configuration
PV_ROOT="${HOME}/ProjectVorticity"
PV_SRC="${PV_ROOT}/src"
PV_BUILD="${PV_ROOT}/build"
PV_LOG="${PV_ROOT}/logs"
PV_WRF_REPO="https://github.com/wrf-model/WRF.git"
