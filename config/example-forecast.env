# Copy this file to ~/ProjectVorticity/config/forecast.env and edit the values.
# All times are UTC. Supply GRIB files covering the full period, including
# boundary-condition times after the forecast start through the forecast end.

PV_START="2026-11-23_00:00:00"
PV_END="2026-11-24_00:00:00"

# Choose the centre of your forecast domain (decimal degrees).
PV_CENTER_LAT="35.0"
PV_CENTER_LON="135.0"

# Path to the extracted WPS static geography dataset (contains e.g. geog/).
# Download/extract the official WPS_GEOG data separately; do not point this at
# the WPS source directory.
PV_GEOG_DIR="$HOME/WRF_DATA/WPS_GEOG"

# Folder containing GRIB files from ONE consistent forecast-data cycle/provider.
PV_GRIB_DIR="$HOME/WRF_DATA/GRIB"
# Vtable name must exist in src/WPS/ungrib/Variable_Tables/, e.g. GFS.
PV_VTABLE="GFS"

# Starter single-domain grid: 100 x 100 at 12 km. This is a configuration
# starting point, not a validated forecast setup for every region or dataset.
PV_E_WE="100"
PV_E_SN="100"
PV_DX="12000"
PV_DY="12000"
PV_TRUELAT1="${PV_CENTER_LAT}"
PV_TRUELAT2="${PV_CENTER_LAT}"
PV_STAND_LON="${PV_CENTER_LON}"
PV_GEOG_RES="default"

# Match the temporal resolution of the supplied GRIB data.
PV_INTERVAL_SECONDS="10800"
PV_MPI_RANKS="2"
PV_HISTORY_MINUTES="60"
# Approximate 6*dx(km), a conservative starting value for a 12-km grid.
PV_TIME_STEP="$((PV_DX / 1000 * 6))"

# These must match the vertical and soil levels written by your WPS metgrid files.
PV_NUM_METGRID_LEVELS="34"
PV_NUM_METGRID_SOIL_LEVELS="4"
PV_NUM_SOIL_LAYERS="4"
